 "narrative": {
  "northStar": "The Glass Wall",
  "overview": "The page is one steel-framed glass partition. Matte black glazing bars are the only line ink; every app is a pane in the grid. Clear, seeded-white glass is the resting state. An app that is out in the world is lit from behind in its own icon colour. Work still in development is frosted.",
  "keyCharacteristics": [
   "Black bars at a constant 8px (6px on phones); text sits inside a pane and never crosses a bar.",
   "One grotesque (Archivo, variable width and weight) for everything.",
   "Real screens in thin black bezels, sometimes cropped by the pane edge like a window.",
   "One slow brightening on load; no flashing, no looping motion."
  ],
  "rules": [
   {
    "name": "The Lit Means Live Rule",
    "body": "A saturated pane is an app that is out in the world. Unreleased work is frosted and never lit.",
    "section": "colors"
   },
   {
    "name": "The Two Notes Rule",
    "body": "Only the action panes use cobalt or oxblood; neither colours an app.",
    "section": "colors"
   },
   {
    "name": "The Pane Type Rule",
    "body": "Type is set inside a pane and never across a glazing bar.",
    "section": "typography"
   },
   {
    "name": "The Flat Wall Rule",
    "body": "Panes never lift; only the phones inside them cast a shadow.",
    "section": "elevation"
   }
  ],
  "dos": [
   "Do keep every claim traceable to a link, a number from git, or a real screenshot.",
   "Do label sample data and in-development work on the pane itself.",
   "Do leave one slow brightening as the only load motion, and remove it under reduced motion."
  ],
  "donts": [
   "Don't light a pane for unreleased work, or frost a live app.",
   "Don't add kickers, section numbers or icon-over-heading card rows; the wall is the structure.",
   "Don't use glyph arrows or emoji as icons; draw them.",
   "Don't let a pane carry a hard offset shadow or gradient text."
  ]
 }
}