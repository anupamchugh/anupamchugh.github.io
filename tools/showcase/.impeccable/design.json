   "html": "<a class=\"ds-note\" href=\"#\"><span>Work with me</span><svg width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 12h17M14 5.5l6.5 6.5-6.5 6.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"square\"/></svg></a>",
   "css": ".ds-note{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:28px;background:#1d4ed8;color:#fff;font-size:1.5rem;font-weight:600;font-stretch:118%;text-decoration:none} .ds-note:hover{filter:brightness(1.12)} .ds-note:focus-visible{outline:3px solid #fff;outline-offset:-9px;box-shadow:inset 0 0 0 6px #0c0d0f}"
  },
