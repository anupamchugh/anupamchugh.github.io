   "name": "Lit pane",
   "kind": "custom",
   "refersTo": "pane-lit",
   "description": "An app that is out in the world, lit in its own colour.",
   "html": "<a class=\"ds-lit\" href=\"#\"><span class=\"ds-nm\">Orbits</span><span class=\"ds-ds\">Plan your own trips and meetups.</span></a>",
